# Copy to .env and fill in. Never commit the real .env.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id (restricts the bot to you during Phase 1)
TELEGRAM_OWNER_ID=

# Anthropic API key
ANTHROPIC_API_KEY=

# IANA timezone used for DND windows and scheduled triggers
KYRAAN_TIMEZONE=Asia/Kolkata
