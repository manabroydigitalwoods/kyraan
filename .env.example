# Copy to .env and fill in. Never commit the real .env.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id (restricts the bot to you during Phase 1)
TELEGRAM_OWNER_ID=

# Anthropic API key — not required while config/permissions.yaml's
# model_tiers use provider: opencode
ANTHROPIC_API_KEY=

# OpenCode Zen key (https://opencode.ai/zen) — stand-in gateway used by
# the default tiers in config/permissions.yaml until there's an Anthropic key
OPENCODE_API_KEY=

# Native OpenAI API key — only needed if a tier's provider is set to "openai"
OPENAI_API_KEY=

# Base URL for a local Ollama server — only needed if a tier's provider is
# set to "ollama"; defaults to http://localhost:11434/v1 if unset
OLLAMA_BASE_URL=

# IANA timezone used for DND windows and scheduled triggers
KYRAAN_TIMEZONE=Asia/Kolkata
