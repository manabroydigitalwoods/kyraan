# Copy to .env and fill in. Never commit the real .env.
# Only the keys used by config/permissions.yaml's current model_tiers are
# actually required to run — the rest are optional, kept ready to switch to.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id (restricts the bot to you during Phase 1)
TELEGRAM_OWNER_ID=

# --- Model provider keys (see config/permissions.yaml's `providers` section) ---

# Anthropic API key
ANTHROPIC_API_KEY=

# Google AI Studio key (https://aistudio.google.com/apikey) — free tier caps
# gemini-3.7-flash at 20 requests/day, too little for real use
GEMINI_API_KEY=

# Native OpenAI API key
OPENAI_API_KEY=

# OpenCode Zen key (https://opencode.ai/zen) — its free models share one
# account-wide rate limit that trips fast under normal dev iteration
OPENCODE_API_KEY=

# Groq key (https://console.groq.com/keys) — fast free-tier inference
GROQ_API_KEY=

# OpenRouter key (https://openrouter.ai/keys) — broad model marketplace,
# includes several free (":free"-suffixed) models
OPENROUTER_API_KEY=

# Base URL for a local Ollama server — no key needed; defaults to
# http://localhost:11434/v1 if unset
OLLAMA_BASE_URL=

# IANA timezone used for DND windows and scheduled triggers
KYRAAN_TIMEZONE=Asia/Kolkata
GOOGLE_CALENDAR_ICS_URL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
HASS_URL=
HASS_TOKEN=

# OPTIONAL upgrade for the places.nearby tool: Google Places API (New).
# Needs GCP billing enabled (card on file); unset = free OpenStreetMap
# Overpass backend, which works without any key.
GOOGLE_MAPS_API_KEY=

# Email bodies, local-only (§3a opt-in): set to "local", re-run
# scripts/setup_google_oauth.py (requests gmail.readonly instead of
# metadata-only), restart. Bodies are then summarized by the LOCAL model
# and never enter a cloud prompt. Unset = senders/subjects only.
KYRAAN_EMAIL_BODIES=

# Home-country bias for geocoding fallbacks (ISO code) — keeps "city
# center mall" resolving in your country, not a same-named place abroad
KYRAAN_HOME_COUNTRY=IN

# TomTom API key — fallback (or sole) provider for routes.eta live-traffic
# ETAs; free tier needs no card: https://developer.tomtom.com
TOMTOM_API_KEY=

# Local SearXNG metasearch container — enables the web.search tool (live
# info in answers). Self-hosted, no API key, no per-query cost. Managed by
# docker/docker-compose.yml in this repo: `cd docker && docker compose up -d`
SEARXNG_URL=http://127.0.0.1:8888

# Local Redis container (same docker-compose) for volatile session state —
# conversation window, summary backlog, confirm stashes, listing caches.
# Unset/"memory" = the pre-Redis behavior (process memory, restart forgets
# everything); "redis" moves it to Redis so a restart doesn't. Any Redis
# failure at runtime falls back to memory automatically, logged once.
#KYRAAN_SESSION_BACKEND=redis
#KYRAAN_REDIS_URL=redis://127.0.0.1:6379/0

# Optional: how long Ollama holds the local model in memory after a
# call (default 30m). Raise it on a machine with RAM to spare; lower
# it on a small one — the model wires several GB while resident.
#KYRAAN_OLLAMA_KEEP_ALIVE=30m

# Web panel token: keeps the same panel link across restarts
KYRAAN_PANEL_TOKEN=
