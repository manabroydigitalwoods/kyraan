#!/bin/sh
# Run the test suite before every commit — the local stand-in for CI while
# the repo has no remote. Bypass deliberately with: git commit --no-verify
echo "pre-commit: running tests..."
.venv/bin/python -m pytest -q
status=$?
if [ $status -ne 0 ]; then
    echo "pre-commit: tests failed — commit blocked (use --no-verify to bypass deliberately)"
fi
exit $status
